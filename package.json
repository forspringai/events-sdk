{
  "name": "@forspring/events",
  "version": "0.4.0",
  "description": "Forspring suite events: the envelope, the type catalog, validation, signing and a D1 outbox for products that publish to the event hub",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forspringai/events-sdk.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
